generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Representa os usuários do sistema (ex: administradores e operadores de caixa).
model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)
  sales     Sale[]
}

enum Role {
  USER
  ADMIN
}

/// Representa os produtos disponíveis para venda na distribuidora, com seu respectivo controle de estoque.
model Product {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String
  price     Float
  costPrice Float      @default(0)
  stock     Int        @default(0)
  packQuantity Int     @default(1)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  saleItems SaleItem[]
  commandItems CommandItem[]

  // Campos de auditoria
  modifierId       Int?
  modifiedEndpoint String?
}

/// Tabela de auditoria gerada via trigger que armazena o histórico de todas as alterações feitas nos produtos.
model ProductHistory {
  id        Int    @id @default(autoincrement())
  productId Int
  code      String
  name      String
  price     Float
  costPrice Float  @default(0)
  stock     Int
  packQuantity Int @default(1)

  // Campos de auditoria
  modifierId       Int?
  modifiedEndpoint String?
  historyStart     DateTime
  historyEnd       DateTime?
}

/// Representa uma transação de venda realizada no PDV, consolidando o valor total e a forma de pagamento.
model Sale {
  id            Int           @id @default(autoincrement())
  total         Float
  totalCost     Float         @default(0)
  discount      Float         @default(0)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  createdAt     DateTime      @default(now())
  
  userId        Int?
  user          User?         @relation(fields: [userId], references: [id])
  
  customerId    Int?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  
  commandTabId  Int?          @unique
  commandTab    CommandTab?   @relation(fields: [commandTabId], references: [id])
  
  items         SaleItem[]
}

enum PaymentMethod {
  MONEY
  PIX
  DEBIT
  CREDIT
  CREDIT_STORE
}

enum SaleStatus {
  COMPLETED
  CANCELED
}

/// Representa a relação de produtos (e suas quantidades) vendidos dentro de uma Venda (Sale) específica.
model SaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  price     Float
  costPrice Float   @default(0)
  sale      Sale    @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

/// Representa as sessões do caixa (abertura e fechamento), mantendo o controle dos saldos ao longo do dia.
model CashRegister {
  id             Int            @id @default(autoincrement())
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  initialBalance Float          @default(0)
  finalBalance   Float?
  status         CashStatus     @default(OPEN)
  movements      CashMovement[]
}

enum CashStatus {
  OPEN
  CLOSED
}

/// Representa as movimentações financeiras individuais (entradas, saídas ou vendas) vinculadas a um caixa aberto.
model CashMovement {
  id             Int          @id @default(autoincrement())
  cashRegisterId Int
  type           MovementType
  amount         Float
  description    String?
  createdAt      DateTime     @default(now())
  cashRegister   CashRegister @relation(fields: [cashRegisterId], references: [id])
}

enum MovementType {
  IN
  OUT
  SALE
}

/// Representa os clientes do estabelecimento (para controle de fiado/contas a receber)
model Customer {
  id        Int      @id @default(autoincrement())
  name      String
  phone     String?
  balance   Float    @default(0) // Saldo devedor
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  sales     Sale[]
  payments  CustomerPayment[]
  commandTabs CommandTab[]
}

/// Histórico de pagamentos de dívidas (fiado) feitos pelos clientes
model CustomerPayment {
  id             Int          @id @default(autoincrement())
  customerId     Int
  amount         Float
  paymentMethod  PaymentMethod
  createdAt      DateTime     @default(now())
  
  customer       Customer     @relation(fields: [customerId], references: [id])
}

/// Representa uma comanda (conta em aberto) para consumo no local
model CommandTab {
  id          Int           @id @default(autoincrement())
  name        String
  status      TabStatus     @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  customerId  Int?
  customer    Customer?     @relation(fields: [customerId], references: [id])
  
  items       CommandItem[]
  sale        Sale?
}

enum TabStatus {
  OPEN
  CLOSED
}

/// Representa os itens consumidos dentro de uma comanda
model CommandItem {
  id            Int        @id @default(autoincrement())
  commandTabId  Int
  productId     Int
  quantity      Int
  price         Float
  costPrice     Float      @default(0)
  addedAt       DateTime   @default(now())
  
  commandTab    CommandTab @relation(fields: [commandTabId], references: [id])
  product       Product    @relation(fields: [productId], references: [id])
}
